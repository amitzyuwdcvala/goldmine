# Gold Providers Default Env Keys
GOLDAPI_KEY=your-goldapi-key
GOLDPRICE_KEY=your-goldprice-key
METALS_DEV_KEY=your-metals-dev-key
METALPRICE_KEY=your-metalprice-key

# Default Active Provider (goldapi | goldprice | metals_dev | metalprice)
ACTIVE_PROVIDER=goldapi

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
